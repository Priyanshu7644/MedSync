PORT=4000

# MongoDB Connection String
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/medsync"

# Cloudinary Credentials (for image uploads)
CLOUDINARY_NAME="your_cloudinary_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_SECRET_KEY="your_cloudinary_secret_key"

# JWT Secret for Authentication
JWT_SECRET="your_jwt_secret_here"

# Admin Credentials
ADMIN_EMAIL="admin@medsync.com"
ADMIN_PASSWORD="adminpassword123"

# Server Host URL (Optional, Render provides RENDER_EXTERNAL_URL automatically)
# Setting this enables the built-in anti-sleep keep-alive pinger (prevents Render spin-down)
# SERVER_URL="https://medsync-api.onrender.com"

# Frontend URL (for Stripe success/cancel redirect)
FRONTEND_URL="http://localhost:5173"

# Payment Gateway
CURRENCY="usd"
STRIPE_SECRET_KEY="sk_test_..."
